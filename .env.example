# Ohne diese Variablen läuft VYSNER One im lokalen Modus (Daten im Browser, kein Login).
# Mit beiden Variablen: Login + Speicherung in Supabase (siehe supabase/README.md).
NEXT_PUBLIC_SUPABASE_URL=https://<projekt-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# E-Mail-Versand von Angeboten/Rechnungen (optional). Ohne SMTP wird das PDF über das Gerät geteilt.
# Direkter Versand ist nur mit Login (Supabase) erlaubt – Schutz gegen Missbrauch als Mail-Relay.
SMTP_HOST=smtp.ihr-anbieter.de
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=rechnung@ihre-domain.de
SMTP_PASS=geheim
MAIL_FROM="VYSNER One <rechnung@ihre-domain.de>"
# Nur für lokale Tests ohne Supabase: MAIL_ALLOW_ANONYMOUS=true

# Tarife & Abrechnung über Stripe (nur serverseitig – NIEMALS ins Repository).
# Ohne diese Variablen zeigt „Tarif & Abrechnung“ nur den Hinweis, dass die Buchung noch nicht aktiv ist.
SUPABASE_SERVICE_ROLE_KEY=<sb_secret_… aus Supabase → Project Settings → API Keys>
STRIPE_SECRET_KEY=sk_live_…
STRIPE_WEBHOOK_SECRET=whsec_…
STRIPE_PRICE_SOLO_MONTHLY=price_…
STRIPE_PRICE_SOLO_YEARLY=price_…
STRIPE_PRICE_BUSINESS_MONTHLY=price_…
STRIPE_PRICE_BUSINESS_YEARLY=price_…
STRIPE_PRICE_TEAM_MONTHLY=price_…
STRIPE_PRICE_TEAM_YEARLY=price_…
# Optional: STRIPE_AUTOMATIC_TAX=true (wenn Stripe Tax aktiv), NEXT_PUBLIC_SITE_URL=https://ihre-domain.de

# Widerruf (optional): Empfänger für Widerrufe über das öffentliche Formular /widerruf (Standard: hallo@vysn.de)
# und Blindkopie aller Widerrufsbestätigungen
# WITHDRAWAL_TO=hallo@vysn.de
# WITHDRAWAL_BCC=buchhaltung@ihre-domain.de

# KI-Sprachassistent (Business/Team): Anthropic-API-Schlüssel – nur beim Hosting hinterlegen
# ANTHROPIC_API_KEY=
